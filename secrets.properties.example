# Skopiuj ten plik jako: secrets.properties  (jest w .gitignore, nie trafi do repo)
# i wpisz swoje klucze z https://developer.ecoflow.com
ECOFLOW_ACCESS_KEY=tu_wklej_access_key
ECOFLOW_SECRET_KEY=tu_wklej_secret_key

# Opcjonalnie: numer seryjny urządzenia. Zostaw pusty/usuń, a apka sama wykryje
# pierwsze urządzenie z Twojego konta (device/list).
ECOFLOW_SN=
